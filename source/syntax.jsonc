  "impulse": [
    "wakeup()",
    "game.newround()",
    "key.[a-z0-9]()",
    "mouse.[0-2].# state #() {state: (up|down)}",
    "(open|close).# strings{building} #.()"
  ],
  "actions": {
    "bool": [
      "comparison.# data_type #(# data_type #, op_comp, # data_type #) {data_type: (bool|double|int|string)}",
      "c.# data_type #(type: left, op_comp, type: right) {data_type: (b|d|i|s)}",

      "not(bool: negate)",

      "mouse.[0-2].state()",
      "window.visibility.get(string: windowID)",
      "visibility.get(s)",
      "window.child.visibility.get(string: windowID, string: elementID)",
      "child.visibility.get(s, s)",
      "tower\\.stunned\\(\\)",
      "game\\.(isBossFight|isTowerTesting)\\(\\)",
      "software\\.enabled\\(string: name# strings{software} #\\)",
      "worker\\.paused\\(string: name\\)"
    ],
    "double": [

    ],
    "int": [

    ],
    "string": [

    ],
    "vector": [

    ],
    "void": [

    ]
  },
  // Everything that's in actions{bool} can be attributed as a condition
  "conditions": ["# actions{bool} #"]
}
