{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cubical Script",
  "patterns": [
    { "include": "#comments" },
    { "include": "#macroNames" },
    { "include": "#macroParameters" },
    { "include": "#macroCalls" },
    { "include": "#dataTypes" },
    { "include": "#metaActions" },
    { "include": "#actions" }
  ],
  "repository": {
    "comments":{
      "patterns": [
        {
          "name": "comment.single_line.tpt2",
          "match": ";\\s+.*$"
        },
        {
          "name": "comment.block.tpt2",
          "begin": ";/\\*",
          "end": ".*\\*/;"
        }
      ]
    },
    "macroNames": {
      "patterns": [
        {
          "name": "entity.name.macro.tpt2",
          "match": "#[\\w|_]+(?=\\s|\\()"
        }
      ]
    },
    "macroParameters": {
      "patterns": [
        {
          "name": "variable.parameter.macro.tpt2",
          "match": "\\(([^)]+)\\)"
        }
      ]
    },
    "macroCalls": {
      "patterns": [
        {
          "name": "variable.other.macro-call.tpt2",
          "match": "\\{[\\w|_]+(\\([^)]*\\))?\\}"
        }
      ]
    },
    "dataTypes":{
      "patterns": [
        {
          "name": "variable.data_types.tpt2",
          "match": "(bool|double|int|string|vector)"
        },
        {
          "name": "variable.data_types.bool.tpt2",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "variable.data_types.double.tpt2",
          "match": "\\b\\d+\\.\\d*\\b"
        },
        {
          "name": "variable.data_types.int.tpt2",
          "match": "\\b\\d+\\b"
        },
        {
          "name": "variable.data_types.string.tpt2",
          "match": "\\b(\"[^\"]*\"|\\'[^\\']*\\')\\b"
        },
        {
          "name": "variable.data_types.vector.tpt2",
          "match": "vec\\(\\s*\\d+\\.\\d*,\\s*\\d+\\.\\d*\\s*\\)"
        }
      ]
    },
    "metaActions":{
      "patterns": [
        {
          "name": "keyword.meta.import.tpt2",
          "match": ":import\\s+\"([^\"]+)\""
        },
        {
          "name": "keyword.meta.budget_cap.tpt2",
          "match": ":budget_cap\\s+(max|\\d+)"
        },
        {
          "name": "keyword.variable.constant.numbers.tpt2",
          "match": ":const\\s+(bool|double|int)\\s+\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s+((true|false)|(\\d+\\.\\d*)|(\\d+))\\b"
        },
        {
          "name": "keyword.variable.constant.string.tpt2",
          "match": ":const\\s+string\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s+(\"[^\"]*\"|\\'[^\\']*\\')"
        },
        {
          "name": "keyword.variable.constant.vector.tpt2",
          "match": ":const\\s+vector\\s+([[a-zA-Z_][a-zA-Z0-9_]*])\\s+vec\\(\\s*\\d+\\.\\d*\\s*,\\s*\\d+\\.\\d*\\s*\\)"
        },
        {
          "name": "keyword.variable.non-constant.tpt2",
          "match": ":(global|local)\\s+(bool|double|int|string|vector)\\s+([a-zA-Z_][a-zA-Z0-9_]*)"
        }
      ]
    },
    "actions":{
      "patterns": [
        {
          "name": "support.function.action.tpt2",
          "match": "^[^#:{\\s][^\\n]*"
        }
      ]
    }
  },
  "scopeName": "source.cubicalscript"
}
